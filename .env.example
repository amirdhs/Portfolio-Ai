# Public base URL without trailing slash. Used for canonical URLs, Open Graph, sitemap and robots.txt.
# Inlined at build time – set it in Vercel for Production and rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://www.example.de

# --- Contact form delivery (SMTP via your own mailbox) ---------------------------
# Leave all of these empty to keep the form in "not configured" mode: it then tells
# visitors honestly that nothing was sent instead of pretending success.
SMTP_HOST=smtp.example.de
# 465 = implicit TLS, 587 = STARTTLS
SMTP_PORT=465
# Optional override; defaults to true for port 465, false otherwise.
SMTP_SECURE=
SMTP_USER=anfragen@example.de
SMTP_PASS=
# Sender shown in the notification email; must be allowed by your mail provider (usually = SMTP_USER).
INQUIRY_FROM="AMIR Website <anfragen@example.de>"
# Mailbox that receives inquiries.
INQUIRY_TO=hallo@example.de
